# Tout est FACULTATIF ici : les clés peuvent aussi se coller dans le back-office (/admin → Paramètres).

# ====== Obligatoire pour que les agents travaillent réellement ======
ANTHROPIC_API_KEY=
# Modèle utilisé par les agents (par défaut claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# ====== Accès au back-office (/admin) ======
ADMIN_PASSWORD=change-moi-tout-de-suite

# URL publique du site (utilisée dans les emails, Stripe, désabonnement)
PUBLIC_URL=http://localhost:3000
PORT=3000

# ====== Base de données permanente gratuite (Turso) — obligatoire sur un hébergement gratuit ======
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ====== Paiement : Stripe (https://dashboard.stripe.com/apikeys) ======
STRIPE_SECRET_KEY=
# Secret du webhook (Dashboard Stripe > Développeurs > Webhooks > endpoint PUBLIC_URL/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# ====== Envoi d'emails (SMTP de votre domaine : Brevo, Mailjet, OVH, Gmail Workspace...) ======
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur, ex : "Prénom - VotreIAPro <contact@votre-domaine.fr>"
MAIL_FROM=

# ====== Autopilote ======
# Intervalle entre deux cycles complets des agents (heures)
CYCLE_HOURS=24
